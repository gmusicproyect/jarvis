# Copia este archivo a .env y rellena solo lo que uses.
# Nunca subas .env al repositorio.

# Identidad
JARVIS_USER_NAME=Juan

# Rutas (opcionales; si vacías se usan defaults del proyecto)
# JARVIS_CONFIG_PATH=
# JARVIS_DATA_DIR=

# LLM local (Ollama) — camino crítico
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Logging
JARVIS_LOG_LEVEL=INFO
# JARVIS_LOG_JSON=true

# --- Proveedores cloud OPCIONALES (dejar vacío si no se usan) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# ELEVENLABS_API_KEY=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
